# Copy to .env, choose your own local password, then export before running Maven.
DB_PORT=5432
# Keep this port consistent with DB_PORT. Use 15432 for both if 5432 is occupied.
DB_URL=jdbc:postgresql://localhost:5432/scheduler
DB_USER=scheduler
DB_PASSWORD=
# Required for API/ALL. Generate a random value; never commit real keys.
SCHEDULER_API_KEY=
# Optional exact-host overrides, e.g. 127.0.0.1,localhost for the local HTTP demo.
SCHEDULER_HTTP_ALLOWED_HOSTS=
